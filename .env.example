# Salin file ini menjadi .env dan isi nilai sebenarnya.
# Jangan pernah commit .env yang berisi kunci sebenarnya ke git.

# Project Supabase (dari Dashboard > Settings > API)
SUPABASE_URL=https://uwshronrpfkypkjqewgw.supabase.co
SUPABASE_ANON_KEY=sb_publishable_ANON_KEY_ANDA_DI_SINI

# Kunci role service (SUPER RAHASIA) - hanya untuk pengelolaan database/server, JANGAN di frontend
SUPABASE_SERVICE_ROLE_KEY=eyJ...SERVICE_ROLE_KEY_ANDA_DI_SINI

# String koneksi database (pooling) - diperlukan beberapa operasi supabase db
DATABASE_URL=postgresql://postgres:PASSWORD_ANDA@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
