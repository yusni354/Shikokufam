# Jangan pernah commit berkas .env asli. Salin berkas ini jadi .env untuk keperluan lokal,
# dan isi nilai yang sama di Vercel: Project > Settings > Environment Variables.
# Frontend hanya memakai SUPABASE_URL dan SUPABASE_ANON_KEY (lihat js/config.js).
# SERVICE_ROLE dan AI key hanya dipakai di folder api/ (server), tidak di browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AI_API_KEY=
GOOGLE_MY_MAPS_EMBED_URL=
