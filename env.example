# Salin file ini menjadi .env, lalu isi nilainya.
# Kemudian jalankan:  npm run config   (membuat assets/config.js otomatis)

# Dari Supabase Dashboard > Settings > API
SUPABASE_URL=https://ID-PROYEK-ANDA.supabase.co

# Kunci PUBLIK (publishable / anon). Aman dipasang di aplikasi karena dibatasi aturan RLS.
SUPABASE_ANON_KEY=sb_publishable_KUNCI_PUBLIK_ANDA

# Hanya untuk perintah "npm run supabase:link" (bukan rahasia)
SUPABASE_PROJECT_REF=ID-PROYEK-ANDA

# PENTING: JANGAN pernah menaruh service_role key atau password database di proyek ini.
# Aplikasi ini berjalan di browser, sehingga apa pun yang ada di sana bisa dilihat siapa saja.
